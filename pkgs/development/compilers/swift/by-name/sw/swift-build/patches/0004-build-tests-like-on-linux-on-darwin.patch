From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ambrus Toth <palpista11@gmail.com>
Date: Mon, 5 Oct 2026 09:10:52 +0200
Subject: [PATCH] Build tests like on Linux on Darwin

nixpkgs uses swift-corelibs-xctest on Darwin because XCTest.framework
from Xcode is not available. Like on Linux, it requires tests to be run
by an executable with a generated entry point instead of bundles that
are loaded by the `xctest` tool from Xcode, and it does not provide the
XCTest APIs that are only available on Darwin.

Build unit tests as dynamic libraries and build the SwiftPM test runner
on Darwin as well, and don't use the Darwin-only XCTest APIs in the
generated entry point.

Test discovery needs libIndexStore, which nixpkgs installs with libclang
instead of the toolchain, so fall back to it.
---
 .../Specs/DarwinProductTypes.xcspec           | 32 +++++++++++++------
 .../TestEntryPointGenerationTaskAction.swift  | 10 +++---
 .../TestEntryPointGenerationTool.swift        |  4 ++-
 3 files changed, 31 insertions(+), 15 deletions(-)

diff --git a/Sources/SWBApplePlatform/Specs/DarwinProductTypes.xcspec b/Sources/SWBApplePlatform/Specs/DarwinProductTypes.xcspec
index d6e43e3..3fcdd9b 100644
--- a/Sources/SWBApplePlatform/Specs/DarwinProductTypes.xcspec
+++ b/Sources/SWBApplePlatform/Specs/DarwinProductTypes.xcspec
@@ -107,12 +107,32 @@
         );
     },
 
+    // Unit Test (built like on Linux because nixpkgs uses swift-corelibs-xctest on Darwin)
+    {
+        _Domain = darwin;
+        Type = ProductType;
+        Identifier = com.apple.product-type.bundle.unit-test;
+        BasedOn = com.apple.product-type.library.dynamic;
+        DefaultBuildProperties = {
+            ENABLE_TESTING_SEARCH_PATHS = YES;
+            // Index store data is required to discover XCTest tests
+            COMPILER_INDEX_STORE_ENABLE = YES;
+            SWIFT_INDEX_STORE_ENABLE = YES;
+            // Testability is needed to generate code to invoke discovered XCTest tests
+            SWIFT_ENABLE_TESTABILITY = YES;
+            // The test runner is built next to the library and finds it via its rpath.
+            EXECUTABLE_PREFIX = "";
+            LD_DYLIB_INSTALL_NAME = "@rpath/$(EXECUTABLE_PATH)";
+            GENERATE_TEST_ANCHOR = YES;
+        };
+    },
+
     // UI Testing Bundle
     {
         _Domain = darwin;
         Type = ProductType;
         Identifier = com.apple.product-type.bundle.ui-testing;
-        BasedOn = com.apple.product-type.bundle.unit-test;
+        BasedOn = default:com.apple.product-type.bundle.unit-test;
         Class = PBXXCTestBundleProductType;
         Name = "UI Testing Bundle";
         Description = "UI Testing Bundle";
@@ -465,13 +485,7 @@
         _Domain = darwin;
         Type = ProductType;
         Identifier = com.apple.product-type.tool.swiftpm-test-runner;
-        Name = "SwiftPM Unit Test Runner";
-        Description = "SwiftPM Unit Test Runner";
-        DefaultBuildProperties = {
-            __SKIP_BUILD = YES;
-        };
-        PackageTypes = (
-            com.apple.package-type.mach-o-executable
-        );
+        // Build the test runner like on Linux because nixpkgs uses swift-corelibs-xctest on Darwin.
+        BasedOn = default:com.apple.product-type.tool.swiftpm-test-runner;
     },
 )
