@@ -644,7 +644,7 @@ class TestEntryPointGenerationTaskAction: TaskAction {
         }
 
         #if canImport(XCTest)
-        #if canImport(Darwin) // XCTIssue is unavailable in swift-corelibs-xctest.
+        #if false // XCTIssue is unavailable in swift-corelibs-xctest.
         extension __SwiftPMTestIssue {
             init(_ issue: XCTIssue) {
