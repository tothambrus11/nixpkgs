From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ambrus Toth <palpista11@gmail.com>
Date: Mon, 5 Oct 2026 17:14:12 +0200
Subject: [PATCH] Use the deployment target for BacktracingDT with strict
 availability

With `SWIFT_STDLIB_ENABLE_STRICT_AVAILABILITY` and a deployment target
older than macOS 26, `BacktracingDT 6.2` is defined as macOS 26.0, but
`DefaultSymbolLocator` uses declarations annotated with it without
availability checks, so the Runtime module fails to build:

    error: 'ElfImageCache' is only available in macOS 26.0 or newer

Define it as the deployment target like without strict availability.
---
 stdlib/public/RuntimeModule/CMakeLists.txt | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/stdlib/public/RuntimeModule/CMakeLists.txt b/stdlib/public/RuntimeModule/CMakeLists.txt
index 43742db..1e20323 100644
--- a/stdlib/public/RuntimeModule/CMakeLists.txt
+++ b/stdlib/public/RuntimeModule/CMakeLists.txt
@@ -134,8 +134,10 @@ else()
 endif()
 
 # Generate BacktracingDT 6.2
+# BacktracingDT is used by declarations that `DefaultSymbolLocator` uses without availability checks, so it must be
+# available at the deployment target even with strict availability.
 set(backtracing_availability)
-if(NOT SWIFT_STDLIB_ENABLE_STRICT_AVAILABILITY AND SWIFT_DARWIN_DEPLOYMENT_VERSION_OSX VERSION_LESS "26.0")
+if(SWIFT_DARWIN_DEPLOYMENT_VERSION_OSX VERSION_LESS "26.0")
   list(APPEND backtracing_availability "-Xfrontend" "-define-availability" "-Xfrontend" "BacktracingDT 6.2:macOS ${SWIFT_DARWIN_DEPLOYMENT_VERSION_OSX}")
 else()
   list(APPEND backtracing_availability "-Xfrontend" "-define-availability" "-Xfrontend" "BacktracingDT 6.2:macOS 26.0")
